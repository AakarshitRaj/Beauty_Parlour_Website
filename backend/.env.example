PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/glowglam

# JWT Secret (any long random string)
JWT_SECRET=glow_glam_super_secret_jwt_key_change_this_2024

# Cloudinary (from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret_here

# UPI Payment (your UPI ID, e.g. from GPay/PhonePe/Paytm)
UPI_ID=glowglam@upi
UPI_NAME=Glow & Glam

# Frontend URL
CLIENT_URL=http://localhost:5173
